# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Публичный https-адрес сервера (нужен для мини-апы, карточек в inline и кнопки меню).
# Локально: ngrok http 8080  ->  PUBLIC_URL=https://xxxx.ngrok-free.app
PUBLIC_URL=

HOST=0.0.0.0
PORT=3000

# Постоянная папка для базы игроков (на хостинге). Пусто — data/ рядом с кодом
DATA_DIR=

# 1 — мини-апа открывается в браузере без Telegram (для разработки)
DEV_MODE=0

# Экономика
ENERGY_MAX=30
ENERGY_REGEN_SEC=90
# Наборы энергии за Telegram Stars (JSON в одну строку; при ошибке берутся значения по умолчанию).
# Купленная энергия добавляется сверх ENERGY_MAX и не сгорает.
ENERGY_PACKS=[{"id":"s","amount":30,"stars":15},{"id":"m","amount":100,"stars":40},{"id":"l","amount":300,"stars":100}]
GARAGE_FREE_SLOTS=5
STARS_FOREVER=10
ROLL_TTL_SEC=86400
FEED_INTERVAL=1.0

# Оценка нейросетью (необязательно). Без ключа работает только эвристика.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Админы через запятую: числовые id Telegram (узнать свой — @userinfobot). Им доступна /admin
ADMIN_IDS=
# Паки премиум-эмодзи для текстов и кнопок (имя из ссылки t.me/addemoji/ИМЯ), можно поменять в /admin
ICON_PACKS=tgiosicons
# Сколько секунд помнить пройденную проверку подписки на спонсоров
SUBSCRIBE_TTL=600
# Час по Москве для ежедневного отчёта по спонсорам
REPORT_HOUR=21
# Раз в сколько сообщений бот в группе напоминает про .ролл (0 — выключить)
GROUP_NUDGE_EVERY=100
# Сколько прокрутов бот даёт за номер по редкости (JSON). Обычные не выкупаются, чтобы энергия не была бесконечной
# SELL_PRICES={"common": 0, "uncommon": 1, "rare": 3, "epic": 10, "legendary": 40, "mythic": 150}
# Склад картинок: id приватного канала, где бот админ. Можно задать и в /admin → «Склад картинок»
STORAGE_CHAT=
